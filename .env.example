# Copier ce fichier en « .env » (jamais versionné) et adapter les valeurs.
#   cp .env.example .env

# ---------- Obligatoires ----------
# Secret de signature des jetons : au moins 32 caractères ALÉATOIRES, propre à chaque installation.
# Générer :  openssl rand -base64 48      (ou, sous PowerShell :  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256})))
JWT_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- Démonstration ----------
# Comptes admin / rh / manager / employe (mot de passe ci-dessous) et Swagger : pratique pour une démonstration,
# à laisser à false pour une vraie installation.
SEED_TEST_ACCOUNTS=true
SEED_TEST_PASSWORD=Test1234!
SWAGGER_ENABLED=true

# ---------- Assistant RH ----------
# ollama (modèle local gratuit) ou claude (API, clé requise)
ASSISTANT_PROVIDER=ollama
# Ollama installé sur la machine (par défaut) ; si Ollama tourne dans Docker (--profile ollama) : http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
ANTHROPIC_API_KEY=

# ---------- Ports et adresses (valeurs par défaut) ----------
BACKEND_PORT=8080
MAILPIT_PORT=8025
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
