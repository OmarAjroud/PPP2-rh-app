          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"nomUtilisateur\": \"rh\", \"motDePasse\": \"{{motDePasse}}\"}" }
          }
        },
        {
          "name": "Connexion manager (MANAGER)",
