            "pm.collectionVariables.set('tokenManager', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"nomUtilisateur\": \"manager\", \"motDePasse\": \"{{motDePasse}}\"}" }
          }
        },
        {
          "name": "Connexion employe (EMPLOYE)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 et jeton reçu', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.collectionVariables.set('tokenEmploye', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
