    "description": "Scénario de démonstration de l'API RH, à lancer dans l'ordre (Runner : « Run collection »).\n\n1. Choisir l'environnement « RH App – local ».\n2. Lancer d'abord le dossier « 0. Connexion » : les jetons des 4 comptes sont enregistrés automatiquement.\n3. Chaque requête vérifie automatiquement le résultat attendu (onglet « Test Results »).\n\nLes demandes de congé sont posées l'an prochain : la collection peut être relancée à volonté.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "motDePasse", "value": "Test1234!" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "tokenRh", "value": "" },
    { "key": "tokenManager", "value": "" },
    { "key": "tokenEmploye", "value": "" },
    { "key": "demandeId", "value": "" },
    { "key": "dateDebut", "value": "" },
    { "key": "dateFin", "value": "" },
    { "key": "annee", "value": "" }
  ],
  "item": [
    {
      "name": "0. Connexion",
      "description": "Connecte les 4 comptes de démonstration et enregistre leurs jetons.",
      "item": [
        {
          "name": "Connexion admin (ADMIN)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 et jeton reçu', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.collectionVariables.set('tokenAdmin', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"nomUtilisateur\": \"admin\", \"motDePasse\": \"{{motDePasse}}\"}" }
          }
        },
        {
          "name": "Connexion rh (RH)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
