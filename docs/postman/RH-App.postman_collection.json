    {
      "name": "2. Cycle d'une demande de congé",
      "description": "Lina demande, Karim valide, le solde est déduit, Lina annule et récupère ses jours. Ouvrir Mailpit (http://localhost:8025) pour voir les emails.",
      "item": [
        {
          "name": "Aperçu : jours ouvrables de la période",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// un lundi de l'an prochain, choisi au hasard : la collection peut être relancée sans chevauchement",
              "const d = new Date(Date.UTC(new Date().getUTCFullYear() + 1, 2, 1));",
              "while (d.getUTCDay() !== 1) d.setUTCDate(d.getUTCDate() + 1);",
              "d.setUTCDate(d.getUTCDate() + 7 * Math.floor(Math.random() * 30));",
              "const fin = new Date(d); fin.setUTCDate(fin.getUTCDate() + 2);",
              "pm.collectionVariables.set('dateDebut', d.toISOString().slice(0, 10));",
              "pm.collectionVariables.set('dateFin', fin.toISOString().slice(0, 10));",
              "pm.collectionVariables.set('annee', String(d.getUTCFullYear()));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('jours ouvrables calculés (week-ends et jours fériés exclus)', () => pm.expect(pm.response.json().joursOuvrables).to.be.above(0));"
            ] } }
          ],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/demandes/jours-ouvrables?dateDebut={{dateDebut}}&dateFin={{dateFin}}" }
        },
        {
          "name": "Lina demande un congé annuel",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201, en attente', () => {",
            "  pm.expect(pm.response.code).to.eql(201);",
            "  pm.expect(pm.response.json().statut).to.eql('EN_ATTENTE');",
            "});",
            "pm.collectionVariables.set('demandeId', String(pm.response.json().id));"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/conges/demandes",
            "body": { "mode": "raw", "raw": "{\"typeCongeId\": 1, \"dateDebut\": \"{{dateDebut}}\", \"dateFin\": \"{{dateFin}}\", \"commentaire\": \"Vacances en famille\"}" } }
        },
        {
          "name": "Même période une seconde fois → 409 (chevauchement)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.expect(pm.response.code).to.eql(409));"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/conges/demandes",
            "body": { "mode": "raw", "raw": "{\"typeCongeId\": 1, \"dateDebut\": \"{{dateDebut}}\", \"dateFin\": \"{{dateFin}}\"}" } }
        },
        {
          "name": "Karim : sa cloche (notification reçue)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('au moins une notification non lue', () => pm.expect(pm.response.json().nombre).to.be.above(0));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenManager}}" }] },
            "url": "{{baseUrl}}/api/notifications/non-lues/nombre" }
        },
        {
          "name": "Karim : demandes de son équipe en attente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('la demande de Lina est dans sa boîte', () => pm.expect(pm.response.json().totalElements).to.be.above(0));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenManager}}" }] },
            "url": "{{baseUrl}}/api/conges/demandes/equipe?statut=EN_ATTENTE" }
        },
        {
          "name": "Lina (employée) tente de valider → 403 (réservé aux managers, RH, ADMIN)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.expect(pm.response.code).to.eql(403));"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/demandes/{{demandeId}}/validation" }
        },
        {
          "name": "Karim valide la demande",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('approuvée par Karim', () => {",
            "  pm.expect(pm.response.json().statut).to.eql('APPROUVEE');",
            "  pm.expect(pm.response.json().decideParNomComplet).to.eql('Karim Mansour');",
            "});"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenManager}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/conges/demandes/{{demandeId}}/validation",
            "body": { "mode": "raw", "raw": "{\"motif\": \"Bonnes vacances !\"}" } }
        },
        {
          "name": "Lina : son solde (jours déduits)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const annuel = pm.response.json().find(s => s.typeCongeCode === 'ANNUEL');",
            "pm.test('jours pris > 0', () => pm.expect(annuel.joursPris).to.be.above(0));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/soldes/moi?annee={{annee}}" }
        },
        {
          "name": "Lina : historique de son solde",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('dernier mouvement : DEDUCTION', () => pm.expect(pm.response.json()[0].typeMouvement).to.eql('DEDUCTION'));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/soldes/moi/mouvements?annee={{annee}}" }
        },
        {
          "name": "Lina : ses notifications (décision reçue)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('dernière notification : congé approuvé', () => pm.expect(pm.response.json().contenu[0].type).to.eql('CONGE_APPROUVE'));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/notifications" }
        },
        {
          "name": "Lina annule (avant le début : jours rendus)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('annulée', () => pm.expect(pm.response.json().statut).to.eql('ANNULEE'));"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/demandes/{{demandeId}}/annulation" }
        },
        {
          "name": "Lina : historique (remboursement)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('dernier mouvement : REMBOURSEMENT', () => pm.expect(pm.response.json()[0].typeMouvement).to.eql('REMBOURSEMENT'));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmploye}}" }] },
            "url": "{{baseUrl}}/api/conges/soldes/moi/mouvements?annee={{annee}}" }
        },
        {
          "name": "Admin : la validation dans le journal d'audit",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('modifications de la demande journalisées', () => pm.expect(pm.response.json().totalElements).to.be.above(0));"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "url": "{{baseUrl}}/api/admin/audit?entite=DemandeConge&entiteId={{demandeId}}" }
        }
      ]
    },
